<form class="modal fade create-folder-modal" id="createFolderForm" tabindex="-1" aria-labelledby="uploadModalLabel"
    aria-hidden="true" action="/dashboard/folders/create-folder" method="post">
    <div class="modal-dialog">
        <div class="modal-content p-3">
            <div class="modal-header p-0 pb-2">
                <h1 class="text-center modal-title w-100 fs-4">Create Folder</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0 pb-3"> <input type="text" class="form-control" maxlength="100" minlength="1"
                    required id="exampleInputEmail1" aria-describedby="emailHelp" name="folder-name"></div>
            <button type="submit" class="btn btn-primary w-100">Create</button>
        </div>
    </div>
</form>