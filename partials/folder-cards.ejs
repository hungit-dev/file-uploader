<% if(folders) { %>
    <% folders.forEach((folder)=>{ %>
        <div class="item" onclick="window.location.href='/dashboard/folders/<%=folder.id%>'">
            <div class="item-icon">
                <svg class="lucide lucide-folder w-full h-auto" xmlns="http://www.w3.org/2000/svg" width="20"
                    height="20" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round">
                    <path
                        d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z">
                    </path>
                </svg>
            </div>
            <div class="dropdown">
                <p>
                    <%=folder.name%>
                </p>
                <svg class="ms-5 dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"
                    onclick="event.stopPropagation()" xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                    viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round" class="lucide lucide-ellipsis-icon lucide-ellipsis">
                    <circle cx="12" cy="12" r="1"></circle>
                    <circle cx="19" cy="12" r="1"></circle>
                    <circle cx="5" cy="12" r="1"></circle>
                </svg>
                <ul class="dropdown-menu" onclick="event.stopPropagation()">
                    <!--Rename folder-->
                    <li><a class="dropdown-item rename-folder-btn" href="#" data-bs-toggle="modal"
                            data-bs-target="#editFolderForm" data-folder-id="<%= folder.id %>"
                            data-folder-name="<%= folder.name %>">
                            <i class="bi bi-pencil me-2"></i>Rename
                        </a></li>
                    <!--Delete folder-->
                    <li><a class="dropdown-item delete-folder-btn" data-folder-id="<%= folder.id %>"><i
                                class=" bi bi-trash me-2"></i>Delete</a>
                    </li>
                </ul>
            </div>
        </div>
        <% }) %>
            <% } %>