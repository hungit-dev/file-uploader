<% if(folders) { %>
    <% folders.forEach((folder)=>{ %>
        <div class="item">
            <div class="item-icon" onclick="window.location.href='/dashboard/folders/<%=folder.id%>'">
                <svg class="lucide lucide-folder w-full h-auto" xmlns="http://www.w3.org/2000/svg" width="20"
                    height="20" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round">
                    <path
                        d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z">
                    </path>
                </svg>
            </div>
            <p>
                <%=folder.name%>
            </p>
        </div>
        <% }) %>
            <% } %>