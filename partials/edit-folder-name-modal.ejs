<form class="modal fade create-folder-modal" id="editFolderForm" tabindex="-1" aria-labelledby="uploadModalLabel"
    aria-hidden="true" method="post">
    <div class="modal-dialog">
        <div class="modal-content p-3">
            <div class="modal-header p-0 pb-2">
                <h1 class="text-center modal-title w-100 fs-4">Edit Name</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0 pb-3"> <input type="text" class="form-control" id="editFolderInput"
                    aria-describedby="emailHelp" name="folder-name"></div>
            <button type="submit" class="btn btn-primary w-100">Rename</button>
        </div>
    </div>
</form>