<!DOCTYPE html>
<html lang="en">

<head>
    <title>
        file-uploader
    </title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/css/form.css">
    <link rel="stylesheet" href="/css/modal.css">
</head>

<body class="d-flex flex-column">
    <header class="container-fluid ">
        <nav class="navbar navbar-expand-lg  container">
            <div class="container-fluid">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <a href="/"><img src="/img/logo.webp" class="rounded-circle" alt="logo"></a>
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 mt-2 mt-lg-0">
                        <li class="nav-item d-flex align-items-center">
                            <span class="d-lg-none me-2">Change Theme</span>
                            <i class="bi bi-sun fs-5"></i>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown"
                                aria-expanded="false">
                                Profile
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#"><i class="bi bi-gear me-2"></i>Setting</a></li>
                                <li><a class="dropdown-item" href="#"><i class="bi bi-person me-2"></i>Users</a></li>
                                <li>
                                    <hr class="dropdown-divider">
                                </li>
                                <li><a class="dropdown-item" href="/log-out"><i
                                            class="bi bi-box-arrow-right me-2"></i>Log
                                        out</a></li>
                            </ul>
                        </li>
                    </ul>

                </div>
            </div>
        </nav>
    </header>
    <main class="container-fluid flex-grow-1 d-flex ">
        <div class="container d-flex flex-column mt-0">
            <div>
                <h1 class="fs-4 m-0 mt-2">Hi <%=username%>,
                </h1>
            </div>
            <div class="d-flex flex-row align-items-center gap-3  p-3 ps-0">
                <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#uploadFile"><i
                        class="bi bi-cloud-upload me-2"></i>Upload</button>
                <button type="button" class="btn new-folder-btn" data-bs-toggle="modal"
                    data-bs-target="#createFolder"><i class="bi bi-folder-plus me-2"></i>New folder</button>
            </div>
            <div>
                <%- include('../partials/breadcrumb',{breadcrumbItems:breadcrumbItems}) %>
            </div>
            <% if (files) { %>
                <div class="flex-grow-1 align-items-center d-flex flex-column mt-5">
                    <p class="fs-3">Folder is empty</p>
                    <p>You haven't added items to this folder.</p>
                </div>
                <% } else { %>
                    <div class="mt-3 d-flex gap-3 flex-wrap items-container">
                        <div class="item">
                            <div class="item-icon">
                                <svg class="lucide lucide-folder w-full h-auto" xmlns="http://www.w3.org/2000/svg"
                                    width="20" height="20" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path
                                        d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z">
                                    </path>
                                </svg>
                            </div>
                            <p>Folder name</p>
                        </div>


                        <div class="item">
                            <div class="item-icon">
                                <svg class="lucide lucide-file w-full h-auto" xmlns="http://www.w3.org/2000/svg"
                                    width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path>
                                    <path d="M14 2v4a2 2 0 0 0 2 2h4"></path>
                                </svg>
                            </div>
                            <p>Folder name</p>
                        </div>

                        <div class="item">
                            <div class="item-icon">
                                <svg class="lucide lucide-image w-full h-auto" xmlns="http://www.w3.org/2000/svg"
                                    width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                                    <rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
                                    <circle cx="9" cy="9" r="2"></circle>
                                    <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>
                                </svg>
                            </div>
                            <p>Folder name</p>
                        </div>

                        <!--view test-->
                        <%- include('../partials/folder-cards',{folders:folders}) %>
                    </div>
                    <% } %>
        </div>

        <!-- Upload Model -->
        <form class="modal fade upload-modal" id="uploadFile" tabindex="-1" aria-labelledby="uploadModalLabel"
            aria-hidden="true" action="/file-upload" method="post" enctype="multipart/form-data">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h1 class="modal-title fs-4" id="uploadModalLabel">
                            Upload Files
                        </h1>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                        </button>
                    </div>
                    <div class="modal-body pt-0 pb-0">
                        <input class="form-control" type="file" id="formFile" name="file">
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Close
                        </button>
                        <button type="submit" class="btn">Upload</button>
                    </div>
                </div>
            </div>
        </form>

        <!-- Create Folder Modal -->
        <form class="modal fade create-folder-modal" id="createFolder" tabindex="-1" aria-labelledby="uploadModalLabel"
            aria-hidden="true" action="/dashboard/folders/create-folder" method="post">
            <div class="modal-dialog">
                <div class="modal-content p-3">
                    <div class="modal-header p-0 pb-2">
                        <h1 class="text-center modal-title w-100 fs-4">Create folder</h1>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-0 pb-3"> <input type="text" class="form-control" id="exampleInputEmail1"
                            aria-describedby="emailHelp" name="folder-name"></div>
                    <button type="submit" class="btn btn-primary w-100">Create</button>
                </div>
            </div>
        </form>

        <!-- File Info -->
        <div class="modal fade file-info-modal" id="fileInfo" tabindex="-1" aria-labelledby="exampleModalLabel"
            aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h1 class="modal-title" id="exampleModalLabel">File Info</h1>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body d-flex align-items-center flex-column">
                        <svg xmlns="http://www.w3.org/2000/svg" width="108" height="108" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"
                            class="lucide lucide-file-icon lucide-file text-zinc-500 text-secondary mb-5">
                            <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path>
                            <path d="M14 2v4a2 2 0 0 0 2 2h4"></path>
                        </svg>
                        <div class="fields">
                            <div class="field">
                                <p>Name:</p>
                                <p class="text-secondary">ConferenceEvents-SpecSheet-DowTheatre-Web.pdf</p>
                            </div>
                            <div class="field">
                                <p>Path:</p>
                                <p class="cloud-drive-url">Cloud drive</p>
                            </div>
                            <div class="field">
                                <p>Size:</p>
                                <p class="text-secondary">1.37MB</p>
                            </div>
                            <div class="field">
                                <p>Type:</p>
                                <p class="text-secondary">PDF File</p>
                            </div>
                            <div class="field">
                                <p>Date created:</p>
                                <p class="text-secondary">2026-01-05, 13:36:06</p>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer d-flex justify-content-between">
                        <span>
                            <svg class="lucide lucide-trash-2" xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round">
                                <path d="M10 11v6"></path>
                                <path d="M14 11v6"></path>
                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path>
                                <path d="M3 6h18"></path>
                                <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                            </svg>
                        </span>
                        <span>
                            <svg class="lucide lucide-share-2" xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="18" cy="5" r="3"></circle>
                                <circle cx="6" cy="12" r="3"></circle>
                                <circle cx="18" cy="19" r="3"></circle>
                                <line x1="8.59" x2="15.42" y1="13.51" y2="17.49"></line>
                                <line x1="15.41" x2="8.59" y1="6.51" y2="10.49"></line>
                            </svg>
                        </span>
                        <span>
                            <svg class="lucide lucide-download" xmlns="http://www.w3.org/2000/svg" width="20"
                                height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 15V3"></path>
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                <path d="m7 10 5 5 5-5"></path>
                            </svg>
                        </span>
                    </div>
                </div>
            </div>
        </div>

    </main>
    <footer class="container-fluid text-center">
        <p>Made by @lamnhathunghuynh</p>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>
    <script src="/js/script.js"></script>
</body>

</html>