<!DOCTYPE html>
<html lang="en">

<head>
    <title>
        file-uploader
    </title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/dashboard-folder.css">
    <link rel="stylesheet" href="/css/form.css">
    <link rel="stylesheet" href="/css/modal.css">
</head>

<body class="d-flex flex-column">
    <!--Header-->
    <header class="container-fluid ">
        <nav class="navbar navbar-expand-lg  container">
            <div class="container-fluid">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <a href="/"><img src="/img/logo.webp" class="rounded-circle" alt="logo"></a>
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 mt-2 mt-lg-0">
                        <li class="nav-item d-flex align-items-center">
                            <span class="d-lg-none me-2">Change Theme</span>
                            <i class="bi bi-sun fs-5"></i>
                        </li>
                        <li class="nav-item ms-lg-2">
                            <a class="nav-link" href="/log-out"></i>Log out</a>
                        </li>

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <!--Main-->
    <main class="container-fluid flex-grow-1 d-flex ">
        <div class="container d-flex flex-column mt-0">
            <div>
                <h1 class="fs-4 m-0 mt-2">Hi <%=username%>,
                </h1>
            </div>
            <div class="d-flex flex-row align-items-center gap-3  p-3 ps-0">
                <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#uploadFileForm"><i
                        class="bi bi-cloud-upload me-2"></i>Upload</button>
                <button type="button" class="btn new-folder-btn" data-bs-toggle="modal"
                    data-bs-target="#createFolderForm"><i class="bi bi-folder-plus me-2"></i>New folder</button>
            </div>
            <div>
                <%- include('../partials/breadcrumb',{breadcrumbItems:breadcrumbItems}) %>
            </div>
            <% if (files.length===0 && folders.length===0) { %>
                <div class="flex-grow-1 align-items-center d-flex flex-column mt-5">
                    <p class="fs-3">Folder is empty</p>
                    <p>You haven't added items to this folder.</p>
                </div>
                <% } else { %>
                    <div class="mt-1 d-flex flex-wrap items-container">
                        <!--Show all folders that user has in their dashboard page-->
                        <%- include('../partials/folder-cards',{folders:folders}) %>
                            <!--Show all files that user has in their dashboard page-->
                            <%- include('../partials/file-cards',{files:files}) %>
                    </div>
                    <% } %>
        </div>
        <!-- Upload modal -->
        <%- include('../partials/upload-modal') %>
            <!-- Create Folder modal -->
            <%- include('../partials/create-folder-modal') %>
                <!--Edit Folder Name modal-->
                <%- include('../partials/edit-folder-name-modal') %>
                    <!-- File Info modal-->
                    <div class="modal fade file-info-modal" id="fileInfo" tabindex="-1"
                        aria-labelledby="exampleModalLabel" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header pb-0">
                                    <h1 class="modal-title fs-2" id="exampleModalLabel">File Info</h1>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                                        aria-label="Close"></button>
                                </div>
                                <div class="modal-body d-flex align-items-center flex-column">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="95" height="95" viewBox="0 0 24 24"
                                        fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round"
                                        stroke-linejoin="round"
                                        class="lucide lucide-file-icon lucide-file text-zinc-500 text-secondary mb-3">
                                        <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path>
                                        <path d="M14 2v4a2 2 0 0 0 2 2h4"></path>
                                    </svg>
                                    <div class="fields">
                                        <div class="field">
                                            <p>Name:</p>
                                            <p class="text-secondary file-name">
                                            </p>
                                        </div>
                                        <div class="field">
                                            <p>Path:</p>
                                            <a class="file-url">Cloud drive</a>
                                        </div>
                                        <div class="field">
                                            <p>Size:</p>
                                            <p class="text-secondary file-size"></p>
                                        </div>
                                        <div class="field">
                                            <p>Type:</p>
                                            <p class="text-secondary file-type"></p>
                                        </div>
                                        <div class="field">
                                            <p>Date created:</p>
                                            <p class="text-secondary file-date-create"></p>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer d-flex justify-content-between">
                                    <span class="delete-file-btn">
                                        <svg class="lucide lucide-trash-2" xmlns="http://www.w3.org/2000/svg" width="20"
                                            height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M10 11v6"></path>
                                            <path d="M14 11v6"></path>
                                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path>
                                            <path d="M3 6h18"></path>
                                            <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                        </svg>
                                    </span>

                                    <span class="download-file-btn">
                                        <svg class="lucide lucide-download" xmlns="http://www.w3.org/2000/svg"
                                            width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M12 15V3"></path>
                                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                            <path d="m7 10 5 5 5-5"></path>
                                        </svg>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
    </main>

    <!--Footer-->
    <footer class="container-fluid text-center">
        <p>Made by @lamnhathunghuynh</p>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>
    <script src="/js/script.js"></script>
</body>

</html>